# Vendor decisions pending — large external tool archives and extracted trees.
# The vendored source we DO ship sits next to README.md inside each per-tool dir;
# the archives below are user-installed locally and don't enter git history.
tools/per-tool/AlphaFold/LocalColabFold
tools/per-tool/catGRANULE_v2/catGRANULE2.0-1.0.0/
tools/per-tool/catGRANULE_v2/*.tar.gz
tools/per-tool/DeepCoil/*.tar.gz
tools/per-tool/ESpritz/*.zip
tools/per-tool/ESpritz/espritz/
tools/per-tool/IUPred3/*.tar.gz
tools/per-tool/IUPred3/iupred3/
tools/per-tool/PLAAC/*.zip
tools/per-tool/PScore/*.tgz
tools/per-tool/PScore/SourceCodeS2/DBS/

# PLAAC: vendor LICENSE, README, cli/src/, build_*.sh, and the prebuilt
